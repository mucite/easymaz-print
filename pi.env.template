# ── Filled in by you before shipping the Pi ───────────────────────────────────

# Restaurant this Pi belongs to (from easymaz admin panel)
RESTAURANT_ID=

# Long-lived API token — generate from admin → Settings → Device Tokens
API_TOKEN=
API_URL=https://api.easymaz.com

# Cloudflare tunnel token — from: cloudflared tunnel create <name>
# Then: cloudflared tunnel token <name>
CLOUDFLARE_TUNNEL_TOKEN=

# The public HTTPS URL for this restaurant's printer
# Format: https://print-<restaurant-id>.easymaz.com
# (after you run: cloudflared tunnel route dns <name> print-<id>.easymaz.com)
BRIDGE_PUBLIC_URL=

# ── Printer (same options as .env) ────────────────────────────────────────────

# USB via CUPS (most common on Pi)
PRINTER_CMD=lp -d "TM-T20III" -o raw -

# OR network printer
# PRINTER_HOST=192.168.1.50
# PRINTER_PORT=9100

PORT=3001